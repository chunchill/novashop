# Copy to .env and adjust. docker compose loads .env automatically.

POSTGRES_USER=novashop
POSTGRES_PASSWORD=novashop

# Host port mapped to container 5432.
# If your machine already uses 5432, set 5433 (recommended on busy laptops):
POSTGRES_HOST_PORT=5433

# App datasource (same user; separate DBs: order_return, payment_refund, commerce, fulfillment)
SPRING_DATASOURCE_USERNAME=novashop
SPRING_DATASOURCE_PASSWORD=novashop

# RabbitMQ defaults match rabbitmq:3-management image
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Prefer CALLBACK_LATER so smoke can assert PENDING_EXTERNAL_EXECUTION stably
PSP_MODE=CALLBACK_LATER

# Optional overrides for smoke / local clients
# COMMERCE_URL=http://localhost:8083
# ORDER_RETURN_URL=http://localhost:8081
# PAYMENT_REFUND_URL=http://localhost:8082
# FULFILLMENT_URL=http://localhost:8084
# DEMO_WEB_URL=http://localhost:8080

# Old Postgres volumes: init SQL runs only once. If commerce/fulfillment DBs are missing:
#   docker compose exec postgres psql -U novashop -d postgres -c 'CREATE DATABASE commerce;'
#   docker compose exec postgres psql -U novashop -d postgres -c 'CREATE DATABASE fulfillment;'
